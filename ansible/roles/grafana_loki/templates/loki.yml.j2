# TEACHER NOTE — OBSERVABILITY 1C DATASOURCE
# CHANGE INSTRUCTIONS: keep this datasource provisioned, private-LAN, non-default, and non-editable.
# Managed by Ansible — roles/grafana_loki/templates/loki.yml.j2
apiVersion: 1

datasources:
  - name: "{{ grafana_loki_datasource_name }}"
    type: loki
    access: proxy
    url: "{{ grafana_loki_url }}"
    isDefault: false
    editable: false
    jsonData:
      maxLines: 1000
