[Unit]
Description=Ansible controlled ERPNext automatic update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hackwell
Group=hackwell
WorkingDirectory=/home/hackwell/infrastructure/ansible
Environment=HOME=/home/hackwell
ExecStart=/home/hackwell/.local/bin/ansible-playbook playbooks/erpnext-update.yml
TimeoutStartSec=1h

[Install]
WantedBy=multi-user.target
